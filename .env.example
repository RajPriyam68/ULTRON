# ULTRON environment configuration
# Copy this file to .env and fill in values. Never commit .env.

ULTRON_APP_NAME=ULTRON
ULTRON_LOG_LEVEL=INFO
ULTRON_DEBUG=false
ULTRON_DATA_DIR=

# Local Ollama (Sprint 3+)
ULTRON_OLLAMA_BASE_URL=http://127.0.0.1:11434
ULTRON_OLLAMA_MODEL=llama3.2

# Cloud LLM — provide your own key. Do not reuse agent environment variables.
USER_LLM_API_KEY=your-api-key-here
USER_LLM_BASE_URL=https://api.example.com/v1
USER_LLM_MODEL=your-model-name
